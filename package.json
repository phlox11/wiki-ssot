{
  "name": "wiki-ssot",
  "version": "0.1.0",
  "description": "A living, enforced Single Source of Truth wiki that coding agents maintain alongside code.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/wiki/test-runner.ts",
    "wiki:inventory": "bun scripts/wiki/cli.ts inventory",
    "wiki:index": "bun scripts/wiki/cli.ts index",
    "wiki:generated": "bun scripts/wiki/cli.ts generated",
    "wiki:kit": "bun scripts/wiki/cli.ts kit",
    "wiki:lint": "bun scripts/wiki/cli.ts lint",
    "wiki:work": "bun scripts/wiki/cli.ts work",
    "wiki:search": "bun scripts/wiki/cli.ts search",
    "wiki:conflicts": "bun scripts/wiki/cli.ts conflicts",
    "wiki:context": "bun scripts/wiki/cli.ts context",
    "wiki:impact": "bun scripts/wiki/cli.ts impact",
    "wiki:verify": "bun scripts/wiki/cli.ts verify",
    "wiki:review-preflight": "bun scripts/wiki/cli.ts review-preflight",
    "wiki:review-bundle": "bun scripts/wiki/cli.ts review-bundle",
    "wiki:review-check": "bun scripts/wiki/cli.ts review-check",
    "wiki:doctor": "bun scripts/wiki/cli.ts doctor",
    "wiki:check": "bun scripts/wiki/cli.ts check",
    "wiki:audit": "bun scripts/wiki/cli.ts audit",
    "wiki:hooks:install": "husky",
    "wiki:tooling:typecheck": "tsc --noEmit -p scripts/wiki/tsconfig.json",
    "wiki:tooling:test": "bun scripts/wiki/test-runner.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "husky": "^9.1.7",
    "typescript": "^5.7.2",
    "yaml": "^2.9.0"
  }
}
