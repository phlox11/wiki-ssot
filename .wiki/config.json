{
  "version": 1,
  "name": "wiki-ssot",
  "publishesKit": true,
  "highRisk": [
    ".github/workflows/checks.yml",
    "scripts/wiki/*.ts"
  ],
  "freshContext": {
    "mode": "required",
    "requiredVerdict": "PASS",
    "evidenceRequired": true,
    "requiredWhen": {
      "kind": "risk-based",
      "changedFileGlobs": [
        ".github/pull_request_template.md",
        ".github/workflows/**",
        ".wiki/config.json",
        "AGENTS.md",
        "README.md",
        "docs/design.md",
        "package.json",
        "scripts/wiki/*.ts",
        "wiki/SCHEMA.md",
        "wiki/WORKFLOW.md",
        "wiki/operations/enforcement.md",
        "wiki/product/invariants.md",
        "wiki/product/scope.md"
      ],
      "affectedInvariants": true,
      "affectedConflicts": true,
      "removedCurrentPages": true
    },
    "trust": {
      "allowedReviewers": ["*"],
      "requireDifferentActor": false,
      "requireAuthenticatedActor": true
    }
  }
}
